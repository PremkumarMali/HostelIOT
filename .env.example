# Copy to .env and fill in. Never commit .env.
# Keep comments on their own lines: Docker reads "KEY=  # note" as the value "# note".

# --- Property ---
PROPERTY_ID=blr01
TZ=Asia/Kolkata

# --- MQTT (Mosquitto) ---
MQTT_HOST=localhost
MQTT_PORT=1883

# --- InfluxDB 3 Core ---
INFLUX_HOST=http://localhost:8181
INFLUX_DATABASE=hotel
# Leave empty while the server runs with --without-auth
INFLUX_TOKEN=

# --- Demo ---
# false hides the fault-injection endpoints
DEMO_MODE=true

# --- Notifications ---
# true = log only, nothing is sent
NOTIFY_DRY_RUN=true
# twilio | msg91
SMS_PROVIDER=twilio

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# MSG91 (India; needs TRAI DLT-registered sender ID + template)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string; must match the webhook setup in Meta
WHATSAPP_VERIFY_TOKEN=
# Used to verify webhook signatures
WHATSAPP_APP_SECRET=
# Meta-approved template for business-initiated alerts
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# --- Management phone numbers (E.164, e.g. +9198XXXXXXXX) ---
# Referenced by config/contacts.yaml via phone_env.
PHONE_GENERAL_MANAGER=
PHONE_CHIEF_ENGINEER=
PHONE_EXECUTIVE_CHEF=
PHONE_DUTY_MANAGER=
PHONE_IT_MANAGER=
